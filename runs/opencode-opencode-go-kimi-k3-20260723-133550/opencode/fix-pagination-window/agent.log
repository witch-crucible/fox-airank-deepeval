import assert from 'node:assert/strict';
import { pageWindow } from './pagination.js';

// 1. total 或 size <= 0 返回空数组
assert.deepEqual(pageWindow(1, 0, 5), []);
assert.deepEqual(pageWindow(1, -3, 5), []);
assert.deepEqual(pageWindow(1, 10, 0), []);
assert.deepEqual(pageWindow(1, 10, -2), []);
assert.deepEqual(pageWindow(0, 0, 0), []);

// 2. current 限制到 [1, total]，size 最多为 total
assert.deepEqual(pageWindow(0, 10, 5), [1,2,3,4,5]);
assert.deepEqual(pageWindow(-5, 10, 5), [1,2,3,4,5]);
assert.deepEqual(pageWindow(99, 10, 5), [6,7,8,9,10]);
assert.deepEqual(pageWindow(3, 3, 10), [1,2,3]);
assert.deepEqual(pageWindow(1, 1, 1), [1]);
assert.deepEqual(pageWindow(5, 2, 7), [1,2]);

// 3. 尽量居中 + 靠端平移保持长度
assert.deepEqual(pageWindow(5, 10, 5), [3,4,5,6,7]);   // 奇数窗口正中
assert.deepEqual(pageWindow(1, 10, 5), [1,2,3,4,5]);   // 左端
assert.deepEqual(pageWindow(2, 10, 5), [1,2,3,4,5]);
assert.deepEqual(pageWindow(10, 10, 5), [6,7,8,9,10]); // 右端
assert.deepEqual(pageWindow(9, 10, 5), [6,7,8,9,10]);

// 4. 偶数 size：current 位于中间两个位置靠右
assert.deepEqual(pageWindow(5, 10, 4), [3,4,5,6]);     // TASK 示例
assert.deepEqual(pageWindow(5, 10, 2), [4,5]);
assert.deepEqual(pageWindow(6, 10, 4), [4,5,6,7]);
assert.deepEqual(pageWindow(1, 10, 4), [1,2,3,4]);     // 偶数窗口左端
assert.deepEqual(pageWindow(10, 10, 4), [7,8,9,10]);   // 偶数窗口右端

// 5. 通用不变量：长度 = min(size,total)，窗口连续且在 [1,total] 内，包含 clamp 后的 current
for (let total = 1; total <= 12; total++) {
  for (let size = 1; size <= 14; size++) {
    for (let current = -2; current <= total + 2; current++) {
      const w = pageWindow(current, total, size);
      const len = Math.min(size, total);
      assert.equal(w.length, len, \`len \${current},\${total},\${size}\`);
      for (let i = 1; i < w.length; i++) assert.equal(w[i], w[i-1] + 1, '连续');
      assert.ok(w[0] >= 1 && w[w.length-1] <= total, '范围内');
      const c = Math.max(1, Math.min(current, total));
      assert.ok(w.includes(c), '包含 current');
      // 尽量居中：current 的索引应为 floor(len/2)，除非被端点平移
      const idx = w.indexOf(c);
      const desired = Math.floor(len / 2);
      if (c - desired >= 1 && c - desired + len <= total) assert.equal(idx, desired, \`居中 \${current},\${total},\${size}\`);
    }
  }
}
console.log('all spec checks passed');
