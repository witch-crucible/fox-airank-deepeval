[0m$ [0mnode --input-type=module -e "
import assert from 'node:assert/strict';
import { calculateCart } from './cart.js';

// 1. quantity <= 0 ignored
assert.deepEqual(calculateCart([{price:100,quantity:0},{price:50,quantity:2}], null, 500, 30), {subtotal:100,discount:0,shipping:30,total:130});
assert.deepEqual(calculateCart([{price:100,quantity:-3},{price:50,quantity:1}], null, 500, 30), {subtotal:50,discount:0,shipping:30,total:80});

// 2. percent coupon on subtotal only, rounded
assert.deepEqual(calculateCart([{price:100,quantity:1}], {percent:10}, 500, 30), {subtotal:100,discount:10,shipping:30,total:120});
assert.deepEqual(calculateCart([{price:105,quantity:1}], {percent:50}, 500, 30), {subtotal:105,discount:53,shipping:30,total:82});

// 3. percent clamped 0..100
assert.deepEqual(calculateCart([{price:200,quantity:1}], {percent:150}, 500, 30), {subtotal:200,discount:200,shipping:30,total:30});
assert.deepEqual(calculateCart([{price:200,quantity:1}], {percent:-20}, 500, 30), {subtotal:200,discount:0,shipping:30,total:230});

// 4. shipping threshold on after-discount amount
assert.deepEqual(calculateCart([{price:300,quantity:1}], {percent:50}, 300, 25), {subtotal:300,discount:150,shipping:25,total:175});
assert.deepEqual(calculateCart([{price:300,quantity:1}], {percent:50}, 150, 25), {subtotal:300,discount:150,shipping:0,total:150});
assert.deepEqual(calculateCart([{price:300,quantity:1}], null, 300, 25), {subtotal:300,discount:0,shipping:0,total:300});

// 5. total never negative
assert.deepEqual(calculateCart([], {percent:100}, 100, 0), {subtotal:0,discount:0,shipping:0,total:0});

// 6. inputs not mutated
const items = [{price:100,quantity:2},{price:5,quantity:0}];
const coupon = {percent:25};
const snapshot = JSON.stringify([items, coupon]);
calculateCart(items, coupon, 100, 10);
assert.equal(JSON.stringify([items, coupon]), snapshot);

// 7. non-percent coupon ignored
assert.deepEqual(calculateCart([{price:100,quantity:1}], {amount:50}, 500, 30), {subtotal:100,discount:0,shipping:30,total:130});

console.log('all edge cases passed');
"
