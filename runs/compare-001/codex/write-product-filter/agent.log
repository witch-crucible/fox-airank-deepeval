import assert from 'node:assert/strict';
import { filterProducts } from './product-filter.js';

const products = [
  { sku: 'A-2', name: 'Alpha', category: 'bag', price: 20, stock: 0 },
  { sku: 'B-1', name: 'beta', category: 'shoe', price: 10, stock: 3 },
  { sku: 'A-1', name: 'Alpha', category: 'bag', price: 20, stock: 2 },
  { sku: 'C-1', name: 'Gamma', category: 'scarf', price: 30, stock: 1 }
];
const options = { query: ' a ', categories: ['bag', 'scarf'], minPrice: 20, maxPrice: 30, inStockOnly: true };
const productsSnapshot = structuredClone(products);
const optionsSnapshot = structuredClone(options);
assert.deepEqual(filterProducts(products, options), [products[2], products[3]]);
assert.deepEqual(filterProducts(products, { sortBy: 'price-asc' }), [products[1], products[0], products[2], products[3]]);
assert.deepEqual(filterProducts(products, { sortBy: 'price-desc' }), [products[3], products[0], products[2], products[1]]);
assert.deepEqual(filterProducts(products, { sortBy: 'name-asc' }), [products[0], products[2], products[1], products[3]]);
assert.deepEqual(filterProducts(products, { categories: [] }), products);
assert.notStrictEqual(filterProducts(products), products);
assert.deepEqual(products, productsSnapshot);
assert.deepEqual(options, optionsSnapshot);
console.log('extended checks passed');
EOF

