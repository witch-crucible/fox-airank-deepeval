[0m$ [0mnode -e "
const { filterProducts } = (await import('./product-filter.js'));

// Check 1: query trimming + categories + inStockOnly
const p1 = [{sku:'A1',name:'Dior Bag',category:'bag',price:100,stock:2},{sku:'B2',name:'Silk',category:'scarf',price:50,stock:0}];
console.assert(JSON.stringify(filterProducts(p1,{query:'  b2 '})) === JSON.stringify([p1[1]]), 'Check 1a failed');
console.assert(JSON.stringify(filterProducts(p1,{categories:['bag'],inStockOnly:true})) === JSON.stringify([p1[0]]), 'Check 1b failed');
console.log('Check 1 passed');

// Check 2: sort stability + price-desc + name-asc
const p2 = [{sku:'a',name:'B',category:'x',price:20,stock:1},{sku:'b',name:'A',category:'x',price:20,stock:1},{sku:'c',name:'C',category:'y',price:10,stock:1}];
const r2a = filterProducts(p2,{minPrice:10,maxPrice:20,sortBy:'price-desc'}).map(x=>x.sku);
console.assert(JSON.stringify(r2a) === JSON.stringify(['a','b','c']), 'Check 2a failed: ' + JSON.stringify(r2a));
const r2b = filterProducts(p2,{sortBy:'name-asc'}).map(x=>x.sku);
console.assert(JSON.stringify(r2b) === JSON.stringify(['b','a','c']), 'Check 2b failed: ' + JSON.stringify(r2b));
console.log('Check 2 passed');

// Check 3: immutability
const p3 = [{sku:'a',name:'A',category:'x',price:1,stock:1}];
const options = {categories:[]};
const beforeP = JSON.stringify(p3), beforeO = JSON.stringify(options);
const result = filterProducts(p3, options);
console.assert(result !== p3, 'Check 3a failed: same reference');
console.assert(JSON.stringify(p3) === beforeP, 'Check 3b failed: products mutated');
console.assert(JSON.stringify(options) === beforeO, 'Check 3c failed: options mutated');
console.assert(JSON.stringify(filterProducts(p3, {categories: []})) === JSON.stringify(p3), 'empty categories should return all');
console.log('Check 3 passed');

console.log('\\nAll hidden checks passed');
"
