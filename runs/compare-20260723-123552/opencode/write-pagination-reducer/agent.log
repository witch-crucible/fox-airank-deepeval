import { calculateCart } from './cart.js';

// Test 1: basic case
const r1 = calculateCart([{ price: 100, quantity: 2 }], null, 300, 20);
console.log('Test 1 (basic):', JSON.stringify(r1));
console.assert(r1.subtotal === 200 && r1.discount === 0 && r1.shipping === 20 && r1.total === 220, 'FAIL');

// Test 2: with coupon
const r2 = calculateCart([{ price: 100, quantity: 3 }], { percent: 10 }, 300, 20);
console.log('Test 2 (coupon 10%):', JSON.stringify(r2));
console.assert(r2.subtotal === 300 && r2.discount === 30 && r2.shipping === 20 && r2.total === 290, 'FAIL');

// Test 3: zero quantity ignored
const r3 = calculateCart([{ price: 100, quantity: 0 }, { price: 50, quantity: 2 }], null, 200, 20);
console.log('Test 3 (zero qty):', JSON.stringify(r3));
console.assert(r3.subtotal === 100 && r3.shipping === 20 && r3.total === 120, 'FAIL');

// Test 4: free shipping
const r4 = calculateCart([{ price: 200, quantity: 2 }], null, 300, 20);
console.log('Test 4 (free shipping):', JSON.stringify(r4));
console.assert(r4.subtotal === 400 && r4.shipping === 0 && r4.total === 400, 'FAIL');

// Test 5: total not negative
const r5 = calculateCart([{ price: 10, quantity: 1 }], null, 100, 50);
console.log('Test 5 (low total):', JSON.stringify(r5));
console.assert(r5.subtotal === 10 && r5.total === 60 && r5.total >= 0, 'FAIL');

// Test 6: percent clamped to [0,100]
const r6 = calculateCart([{ price: 200, quantity: 1 }], { percent: 150 }, 200, 20);
console.log('Test 6 (percent > 100):', JSON.stringify(r6));
console.assert(r6.discount === 200, 'FAIL: expected discount 200, got ' + r6.discount);

// Test 7: negative quantity ignored
const r7 = calculateCart([{ price: 100, quantity: -1 }, { price: 50, quantity: 1 }], null, 100, 20);
console.log('Test 7 (negative qty):', JSON.stringify(r7));
console.assert(r7.subtotal === 50, 'FAIL: expected subtotal 50');

// Test 8: no mutation
const items = [{ price: 100, quantity: 2 }];
const before = JSON.stringify(items);
calculateCart(items, null, 300, 20);
console.assert(JSON.stringify(items) === before, 'FAIL: mutated input');

console.log('All tests passed');
"
