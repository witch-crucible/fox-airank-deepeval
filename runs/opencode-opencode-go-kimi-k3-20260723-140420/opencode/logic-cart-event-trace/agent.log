[0m$ [0mnode -e '
const events = require("./cart-events.json");

// 1) 按 seq（发起顺序）应用 => 预期最终状态
const intended = new Set();
for (const e of [...events].sort((a,b)=>a.seq-b.seq)) {
  if (e.type === "add_item") intended.add(e.item_id);
  else if (e.type === "remove_item") intended.delete(e.item_id);
}

// 2) 按 received_at（到达顺序）应用 => 实际最终状态
const actual = new Set();
for (const e of [...events].sort((a,b)=>a.received_at.localeCompare(b.received_at))) {
  if (e.type === "add_item") actual.add(e.item_id);
  else if (e.type === "remove_item") actual.delete(e.item_id);
}

// 3) 乱序事件对：seq_i < seq_j 但 received_i > received_j
let pairs = [];
for (let i=0;i<events.length;i++) for (let j=i+1;j<events.length;j++) {
  const a=events[i], b=events[j];
  if (a.seq < b.seq && a.received_at > b.received_at) pairs.push([a.seq,b.seq]);
}

// 4) 受影响商品：最终状态与预期不一致的商品
const allItems = new Set(events.map(e=>e.item_id));
const affected = [...allItems].filter(id => intended.has(id) !== actual.has(id));

console.log("intended cart:", [...intended]);
console.log("actual cart:  ", [...actual]);
console.log("out_of_order_pairs:", pairs.length, pairs);
console.log("affected_items:", affected.length, affected);
'
