[0m$ [0mnode --input-type=module -e '
import assert from "node:assert/strict";
import { paginationReducer } from "./pagination-reducer.js";

// SET_PAGE: 无数据时最后一页为 1
assert.deepEqual(paginationReducer({ page: 3, pageSize: 10, total: 0 }, { type: "SET_PAGE", page: 5 }), { page: 1, pageSize: 10, total: 0 });
// SET_PAGE: 下限钳制到 1
assert.deepEqual(paginationReducer({ page: 3, pageSize: 10, total: 35 }, { type: "SET_PAGE", page: 0 }), { page: 1, pageSize: 10, total: 35 });
// SET_PAGE: 正常值
assert.deepEqual(paginationReducer({ page: 1, pageSize: 10, total: 35 }, { type: "SET_PAGE", page: 3 }), { page: 3, pageSize: 10, total: 35 });

// SET_PAGE_SIZE: 保持首条记录零基下标 (page 3, size 10 -> 首记录下标 20; size 5 -> page 5)
assert.deepEqual(paginationReducer({ page: 3, pageSize: 10, total: 35 }, { type: "SET_PAGE_SIZE", pageSize: 5 }), { page: 5, pageSize: 5, total: 35 });
// SET_PAGE_SIZE: 非法值返回原对象（同一引用）
const s1 = { page: 2, pageSize: 10, total: 35 };
assert.equal(paginationReducer(s1, { type: "SET_PAGE_SIZE", pageSize: 0 }), s1);
assert.equal(paginationReducer(s1, { type: "SET_PAGE_SIZE", pageSize: -3 }), s1);
assert.equal(paginationReducer(s1, { type: "SET_PAGE_SIZE", pageSize: 2.5 }), s1);

// SET_TOTAL: 负数钳到 0 并前修 page
assert.deepEqual(paginationReducer({ page: 4, pageSize: 10, total: 35 }, { type: "SET_TOTAL", total: -5 }), { page: 1, pageSize: 10, total: 0 });
// SET_TOTAL: 缩小时前修 page
assert.deepEqual(paginationReducer({ page: 4, pageSize: 10, total: 35 }, { type: "SET_TOTAL", total: 25 }), { page: 3, pageSize: 10, total: 25 });
// SET_TOTAL: 非整数取整
assert.deepEqual(paginationReducer({ page: 1, pageSize: 10, total: 0 }, { type: "SET_TOTAL", total: 25.9 }), { page: 1, pageSize: 10, total: 25 });
// SET_TOTAL: 增大时 page 不变
assert.deepEqual(paginationReducer({ page: 2, pageSize: 10, total: 35 }, { type: "SET_TOTAL", total: 100 }), { page: 2, pageSize: 10, total: 100 });

// RESET
assert.deepEqual(paginationReducer({ page: 4, pageSize: 20, total: 500 }, { type: "RESET" }), { page: 1, pageSize: 20, total: 0 });

// 未知 action 返回原对象引用
const s2 = { page: 1, pageSize: 10, total: 5 };
assert.equal(paginationReducer(s2, { type: "UNKNOWN" }), s2);

// 输入不被修改
const s3 = { page: 2, pageSize: 10, total: 35 };
const a3 = { type: "SET_TOTAL", total: 5 };
paginationReducer(s3, a3);
assert.deepEqual(s3, { page: 2, pageSize: 10, total: 35 });
assert.deepEqual(a3, { type: "SET_TOTAL", total: 5 });

console.log("all edge-case checks passed");
'
