{
  "codex-luna-medium": {
    "agent": "Codex",
    "model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "command": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "--ephemeral",
      "-s",
      "workspace-write",
      "--add-dir",
      "{output_dir}",
      "-m",
      "gpt-5.6-luna",
      "-c",
      "model_reasoning_effort=\"medium\"",
      "{prompt}"
    ]
  },
