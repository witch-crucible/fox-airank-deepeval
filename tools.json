{
  "codex": {
    "command": ["codex", "exec", "--skip-git-repo-check", "--ephemeral", "-s", "workspace-write", "{prompt}"]
  },
  "claude": {
    "command": ["claude", "-p", "--permission-mode", "auto", "--no-session-persistence", "{prompt}"]
  },
  "qwen": {
    "command": ["qwen", "-p", "--yolo", "{prompt}"]
  },
  "opencode": {
    "agent": "build",
    "command": ["opencode", "run", "--pure", "--auto", "--dir", "{workspace}", "--agent", "build", "{prompt}"]
  }
}
